# Ambil dari Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
# Contoh: postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# String acak bebas, buat enkripsi session cookie. Ganti dengan nilai unik sebelum deploy.
SESSION_SECRET=

NODE_ENV=development
